#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../../.." && pwd)
"$here/lib/tmux-tty.sh" start sjujperpowers "$root" bash --noprofile --norc
"$here/lib/tmux-tty.sh" send sjujperpowers "PS1='verify\$ '; echo __READY"
"$here/lib/tmux-tty.sh" wait sjujperpowers '^__READY' 10
