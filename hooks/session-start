#!/usr/bin/env bash
# SessionStart hook for sjujperpowers plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-sjujperpowers content
using_sjujperpowers_content=$(cat "${PLUGIN_ROOT}/skills/using-sjujperpowers/SKILL.md" 2>&1 || echo "Error reading using-sjujperpowers skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_sjujperpowers_escaped=$(escape_for_json "$using_sjujperpowers_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have sjujperpowers.\n\n**Below is the full content of your 'sjujperpowers:using-sjujperpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_sjujperpowers_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON in Claude Code's nested SessionStart shape.
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
